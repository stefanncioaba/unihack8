# Copy this file to `.env` (git-ignored) and fill it in.
# PUBLIC values only: Expo bundles every EXPO_PUBLIC_ variable into the app.

# Supabase dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) or the legacy `anon` key. Never the service_role key.
EXPO_PUBLIC_SUPABASE_KEY=

# The laptop running the Spring API, reachable from the phone on the same Wi-Fi
# (find it with `ipconfig`, Wi-Fi adapter, IPv4 address).
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:8080

# The app always uses the real backend (PLAN 17.1). There is no mock switch any more;
# the mock backend in testing/mocks is used by the Jest tests only.
