{
  "expo": {
    "name": "Connected Communities",
    "slug": "connected-communities",
    "scheme": "connectedcommunities",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090A18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Connected Communities to show your position on the map and plan trips."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Connected Communities to scan event tickets.",
          "recordAudioAndroidPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "backgroundColor": "#090A18"
  }
}
